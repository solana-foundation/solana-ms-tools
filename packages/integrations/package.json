{
  "name": "@solana-foundation/ms-tools-integrations",
  "version": "0.1.4",
  "description": "Handles integrations with third-party services like HubSpot, providing a centralized location for managing these connections",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup ./src/index.ts --config=./tsup-esm.config.mjs --tsconfig=./tsconfig.json",
    "dev": "pnpm run build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx}\" --config ./prettier.config.js",
    "format:fix": "pnpm run format --write",
    "prepublish": "pnpm run build"
  },
  "peerDependencies": {
    "next-sanity": "^11.6.10",
    "react": "^18.0.0 || ^19.0.0",
    "sanity": "^4.19.0"
  },
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@solana-foundation/ms-tools-config": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.10.1",
    "prettier": "^3.7.3"
  },
  "devDependencies": {
    "next-sanity": "^11.6.10",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.0",
    "sanity": "^4.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.0.14"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
