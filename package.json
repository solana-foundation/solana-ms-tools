{
  "name": "@solana-foundation/ms-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "changeset": "changeset",
    "clear": "turbo run clear && rimraf node_modules .turbo",
    "manypkg": "manypkg check",
    "manypkg:fix": "manypkg fix",
    "playwright:install": "pnpm -filter '*ui' playwright:install",
    "prepublish": "turbo run prepublish",
    "storybook": "turbo run storybook",
    "test": "pnpm run manypkg && browserslist-lint && turbo run test"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20 || ^21 || ^22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@manypkg/cli": "^0.25.1",
    "@solana-foundation/ms-tools-config": "workspace:^",
    "browserslist-lint": "^0.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.2",
    "sugarss": "^5.0.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.16"
  },
  "pnpm": {
    "overrides": {
      "prismjs": "^1.30.0",
      "tar-fs": "^2.1.3"
    }
  },
  "browserslist": [
    "> 0.2%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ]
}
